# SACH AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Application Mode
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & LLM Providers (Optional - SACH AI works fully in Offline/Deterministic Demo Mode if keys are not set)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=offline_demo  # Options: offline_demo, openai, gemini, groq
LLM_MODEL=gpt-4o-mini

# Speech-to-Text & Text-to-Speech
STT_ENGINE=local_speech_recognition  # Options: local_speech_recognition, whisper_api, browser_native
TTS_ENGINE=gtts                     # Options: gtts, browser_native

# Database (Default: SQLite local database)
DATABASE_URL=sqlite:///./sach_ai.db

# Security & Data Retention
ENABLE_AUDIO_STORAGE=false
MAX_AUDIO_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=60
